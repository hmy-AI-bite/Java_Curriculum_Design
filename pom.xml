<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ascent</groupId>
    <artifactId>ascent-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AscentSys Server</name>
    <description>AscentSys Java 课程设计 - 第一周后端框架</description>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <sqlite.version>3.46.1.3</sqlite.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- SQLite JDBC 驱动：W1 开始用真实数据库替代 product.db/user.db 文本文件 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- JUnit 5：W1 只测密码、用户 DAO、登录/注册 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          提示：当前工程还是 Eclipse 的 src/com/ascent 结构。
          W1 为了不打断前端同学，先让 Maven 直接以 src 为源码根，
          只编译新后端包（common/server/service/dao/db），
          旧的 bean/ui/util 继续留给旧客户端，W2 再迁移。
        -->
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>

        <resources>
            <!-- 放到 target/classes/db/schema.sql，代码里用 /db/schema.sql 读取 -->
            <resource>
                <directory>db</directory>
                <targetPath>db</targetPath>
                <includes>
                    <include>schema.sql</include>
                </includes>
            </resource>
            <!-- app.properties -->
            <resource>
                <directory>src/resources</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>11</release>
                    <encoding>UTF-8</encoding>
                    <!-- W1 先排除旧代码；等前端迁移到新包后删掉这三行 exclude -->
                    <excludes>
                        <exclude>com/ascent/bean/**</exclude>
                        <exclude>com/ascent/ui/**</exclude>
                        <exclude>com/ascent/util/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
